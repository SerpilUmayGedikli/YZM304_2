import torch
import numpy as np
from torch.utils.data import DataLoader
from torchvision import datasets, transforms
from FeatureExtractor import FeatureExtractor
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report, confusion_matrix

# Veriyi hazırla
transform = transforms.Compose([
    transforms.ToTensor(),
    transforms.Normalize((0.1307,), (0.3081,))
])
train_dataset = datasets.MNIST(root='./data', train=True, download=True, transform=transform)
test_dataset = datasets.MNIST(root='./data', train=False, download=True, transform=transform)
train_loader = DataLoader(train_dataset, batch_size=100, shuffle=False)
test_loader = DataLoader(test_dataset, batch_size=100, shuffle=False)

# Feature extractor modelini yükle
trained_cnn = torch.load("your_trained_model.pth")  # Yükle
feature_extractor = FeatureExtractor(trained_cnn)

# Özellik çıkar ve kaydet
def extract_and_save_features(data_loader, filename_x, filename_y):
    features = []
    labels = []
    with torch.no_grad():
        for images, targets in data_loader:
            output = feature_extractor(images)
            features.append(output.numpy())
            labels.append(targets.numpy())
    np.save(filename_x, np.concatenate(features))
    np.save(filename_y, np.concatenate(labels))

extract_and_save_features(train_loader, "train_features.npy", "train_labels.npy")
extract_and_save_features(test_loader,  "test_features.npy", "test_labels.npy")

# Random Forest modelini eğit ve test et
X_train = np.load("train_features.npy")
y_train = np.load("train_labels.npy")
X_test  = np.load("test_features.npy")
y_test  = np.load("test_labels.npy")

clf = RandomForestClassifier(n_estimators=100)
clf.fit(X_train, y_train)
y_pred = clf.predict(X_test)

# Sonuçlar
print(confusion_matrix(y_test, y_pred))
print(classification_report(y_test, y_pred))
